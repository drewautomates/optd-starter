// =============================================================================
// Opening Range (ORB) — High / Low / Mid + N-close breakout signal
// =============================================================================
// Plots three levels from a user-defined opening-range window:
//   ORH (range high), ORL (range low), ORM (range midpoint).
// Lines DEVELOP during the Opening Range Time and DISPLAY across the
// Regular Session Time, then reset the next day.
//
// ARCHITECTURE (timeframe-stable, artifact-free):
//   - The HIGH/LOW LEVELS are timeframe-invariant (the highest high over a clock
//     window is the same number on 1m or 30m bars), so they are computed INLINE
//     on the chart timeframe. This draws smoothly, resets cleanly each day, and
//     is IDENTICAL whether you run the indicator or the strategy.
//   - Only the "N consecutive closes outside" COUNTER is timeframe-dependent, so
//     that — and only that — is computed on the fixed "Signal timeframe".
//   Example: Signal TF = 1m, N = 7  -> needs 7 consecutive 1-min closes outside.
//            Signal TF = 5m, N = 1  -> needs 1 single 5-min close outside.
//   A close back inside the range resets the consecutive counter.
//
// Author: OPTD  —  Pine Script v6
// =============================================================================
//@version=6
indicator("OPTD — Opening Range (ORB)", shorttitle="OPTD ORB", overlay=true, max_lines_count=500, max_labels_count=500)

// ----------------------------------------------------------------------------
// INPUTS
// ----------------------------------------------------------------------------
g_time   = "Sessions (EST)"
orSess   = input.session("0930-1000", "Opening Range Time (EST)", group=g_time, tooltip="Window that builds the range. Lines develop here.")
rthSess  = input.session("0930-1600", "Regular Session Time (EST)", group=g_time, tooltip="Window the lines are displayed across. Should contain the opening range.")
tz       = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "America/Los_Angeles", "UTC"], group=g_time)

g_sig    = "Breakout Signal"
sigTF    = input.timeframe("1", "Signal timeframe", group=g_sig, tooltip="Timeframe the breakout COUNTER runs on. The range levels are timeframe-invariant and always drawn on the chart timeframe; only the consecutive-close count uses this. Independent of the chart timeframe.")
nCloses  = input.int(1, "Consecutive closes outside range for signal", minval=1, maxval=50, group=g_sig, tooltip="Number of CONSECUTIVE signal-timeframe closes beyond ORH/ORL required to flag a breakout. A close back inside resets the count.")
showSig  = input.bool(true, "Show breakout markers", group=g_sig)

g_style  = "Style"
colH     = input.color(color.new(#2962ff, 0),  "ORH", inline="h", group=g_style)
colL     = input.color(color.new(#e91e63, 0),  "ORL", inline="l", group=g_style)
colM     = input.color(color.new(#ffffff, 0),  "ORM", inline="m", group=g_style)
lineW    = input.int(2, "Line width", minval=1, maxval=4, group=g_style)
showMid  = input.bool(true, "Show midline", group=g_style)
showFill = input.bool(true, "Shade range", group=g_style)
fillOp   = input.int(92, "Range fill transparency", minval=0, maxval=100, group=g_style)
showLbl  = input.bool(true, "Price-scale labels", group=g_style)

// ----------------------------------------------------------------------------
// OR LEVELS — computed INLINE on the chart timeframe (timeframe-invariant).
// ----------------------------------------------------------------------------
inOR  = not na(time(timeframe.period, orSess,  tz))
inRTH = not na(time(timeframe.period, rthSess, tz))
orOpen  = inOR  and not inOR[1]     // first bar of the opening range
orClose = not inOR and inOR[1]      // first bar after the opening range
newDay  = inRTH and not inRTH[1]    // first bar of the regular session

var float orH = na
var float orL = na
var bool  orDone = false

if orOpen
    orH := high
    orL := low
    orDone := false
else if inOR
    orH := math.max(orH, high)
    orL := math.min(orL, low)
if orClose
    orDone := true
// clear yesterday's range once a new session begins, before the OR rebuilds
if newDay and not inOR
    orH := na
    orL := na
    orDone := false
orM = (orH + orL) / 2

// ----------------------------------------------------------------------------
// SIGNAL COUNTER — the ONLY timeframe-dependent piece. Runs on the signal TF
// and returns continuous counts; the breakout edge is detected on the chart.
// ----------------------------------------------------------------------------
f_count() =>
    _inOR  = not na(time(timeframe.period, orSess,  tz))
    _inRTH = not na(time(timeframe.period, rthSess, tz))
    _orOpen  = _inOR  and not _inOR[1]
    _orClose = not _inOR and _inOR[1]
    _newDay  = _inRTH and not _inRTH[1]
    var float _orH = na
    var float _orL = na
    var bool  _orDone = false
    if _orOpen
        _orH := high
        _orL := low
        _orDone := false
    else if _inOR
        _orH := math.max(_orH, high)
        _orL := math.min(_orL, low)
    if _orClose
        _orDone := true
    if _newDay and not _inOR
        _orH := na
        _orL := na
        _orDone := false
    var int _up = 0
    var int _dn = 0
    if _orOpen or _newDay
        _up := 0
        _dn := 0
    if _inRTH and _orDone and not na(_orH)
        if close > _orH
            _up += 1
            _dn := 0
        else if close < _orL
            _dn += 1
            _up := 0
        else
            _up := 0
            _dn := 0
    [_up, _dn]

// A request.security signal TF must be >= the chart TF; clamp if the chart is coarser.
sigSecs   = timeframe.in_seconds(sigTF)
chartSecs = timeframe.in_seconds(timeframe.period)
tfClamped = chartSecs > sigSecs
effTF     = tfClamped ? timeframe.period : sigTF
[upCount, dnCount] = request.security(syminfo.tickerid, effTF, f_count(), lookahead=barmerge.lookahead_off)

// Breakout edge: the bar the count first reaches the threshold (after OR is done).
breakUp = not na(orH) and orDone and upCount >= nCloses and (na(upCount[1]) or upCount[1] < nCloses)
breakDn = not na(orL) and orDone and dnCount >= nCloses and (na(dnCount[1]) or dnCount[1] < nCloses)

// on-chart warning when the chart is too coarse to honor the signal TF
var label warnLbl = na
if barstate.islast
    label.delete(warnLbl)
    if tfClamped
        warnLbl := label.new(bar_index, high, "Chart TF coarser than Signal TF (" + sigTF + ") — signal computed on chart TF. Lower the chart timeframe for a finer signal.", color=color.new(color.orange, 20), textcolor=color.white, style=label.style_label_down, size=size.small)

// ----------------------------------------------------------------------------
// PLOTS — display across the chart's view of the regular session
// ----------------------------------------------------------------------------
showLevels = inRTH and not na(orH)
pH = showLevels ? orH : na
pL = showLevels ? orL : na
pM = showLevels and showMid ? orM : na

pltH = plot(pH, "ORH", color=colH, linewidth=lineW, style=plot.style_linebr)
pltL = plot(pL, "ORL", color=colL, linewidth=lineW, style=plot.style_linebr)
plot(pM, "ORM", color=colM, linewidth=1, style=plot.style_linebr)

fill(pltH, pltL, color=showFill ? color.new(colH, fillOp) : na, title="Range fill")

// price-scale labels: one tracking label per level on the latest bar
var label lblH = na
var label lblL = na
var label lblM = na
if barstate.islast and showLbl and not na(orH)
    label.delete(lblH)
    label.delete(lblL)
    label.delete(lblM)
    lblH := label.new(bar_index, orH, "ORH " + str.tostring(orH, format.mintick), color=na, textcolor=colH, style=label.style_label_left, size=size.small)
    lblL := label.new(bar_index, orL, "ORL " + str.tostring(orL, format.mintick), color=na, textcolor=colL, style=label.style_label_left, size=size.small)
    if showMid
        lblM := label.new(bar_index, orM, "ORM " + str.tostring(orM, format.mintick), color=na, textcolor=colM, style=label.style_label_left, size=size.small)

// ----------------------------------------------------------------------------
// BREAKOUT MARKERS + ALERTS
// ----------------------------------------------------------------------------
plotshape(showSig and breakUp, "Breakout Up", style=shape.triangleup,   location=location.belowbar, color=colH, size=size.small, text="OR↑")
plotshape(showSig and breakDn, "Breakout Down", style=shape.triangledown, location=location.abovebar, color=colL, size=size.small, text="OR↓")

alertcondition(breakUp, "OR Breakout Up",   "Price closed above the opening range (N consecutive signal-TF closes)")
alertcondition(breakDn, "OR Breakout Down", "Price closed below the opening range (N consecutive signal-TF closes)")

// ----------------------------------------------------------------------------
// STATUS LINE VALUES
// ----------------------------------------------------------------------------
plotchar(orH, "ORH val", "", location.top, color=na, display=display.status_line)
plotchar(orL, "ORL val", "", location.top, color=na, display=display.status_line)
plotchar(orM, "ORM val", "", location.top, color=na, display=display.status_line)
